DB_USER=root
DB_PASSWORD=root
DB_PORT=3306

# Direcciones internas de los servicios (nombre del servicio en la red de Docker Compose)
USUARIOS_URL=http://usuarios:5000
ESPACIOS_URL=http://espacios:5000
DISPONIBILIDAD_URL=http://disponibilidad:5000
RESERVAS_URL=http://reservas:5000

# Timeout (segundos de espera maxima a otro servicio)
GATEWAY_TIMEOUT=5
USUARIOS_TIMEOUT=2
ESPACIOS_TIMEOUT=2
SERVICIOS_TIMEOUT=2

# Circuit breaker
CB_MAX_FALLOS=3
CB_RECUPERACION=30
